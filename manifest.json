{
  "manifest_version": 3,
  "name": "ILIAS Deadline Checker",
  "version": "1.4.0",
  "author": "elathq | Younes",
  "description": "Diese Erweiterung zeigt dir alle anstehenden Praktikums-Fristen und Abgaben mit nur einem Klick direkt in deinem Browser.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.ili.fh-aachen.de/*",
    "https://discord.com/api/webhooks/*"
  ], 
  "icons": {
    "16": "img/icon_16.png",
    "48": "img/icon_48.png",
    "128": "img/icon_128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "img/icon_16.png",
      "48": "img/icon_48.png",
      "128": "img/icon_128.png"
    }
  }
}